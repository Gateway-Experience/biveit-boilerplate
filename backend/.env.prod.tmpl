# The project's backend in PRODUCTION, rendered by biveit at every deployment and handed straight to the site's
# container as its environment -- it's never written into the workspace, so editing a copy changes nothing.
# Keys the app needs in prod go here, in the boilerplate (biveit renders it from its own checkout).
ENV=prod
APP_NAME=project_{{{project_id}}}
# Behind nginx in the same container, which serves the built frontend and passes /api/ on.
API_HOST=127.0.0.1
API_PORT={{{backend_port}}}
API_RELOAD=false

# The site's own Mongo user (prod only -- not the owner's dev one); this project's prod database.
MONGO_URI={{{mongo_uri}}}
MONGO_DB={{{mongo_db}}}

# The site's own Redis, in its container (data on the site's volume).
REDIS_URL=redis://127.0.0.1:6379/0

# Derived per project, apart from dev's: nothing in the dev environment opens the live site.
JWT_SECRET={{{secret("jwt_secret")}}}
JWT_EXPIRY_SECONDS=1296000
ADMIN_TOKEN={{{secret("admin_token")}}}
MASTER_PASSWORD=

CORS_ALLOWED_ORIGINS={{{site_origins}}}
