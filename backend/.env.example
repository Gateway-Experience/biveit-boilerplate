# Base config loaded by src/config.py (via python-dotenv). Keys match the Settings field names
# (no prefix). Copy to .env.local for development. In prod, .env.prod overrides these; real env vars
# override both.

ENV=local
APP_NAME=backend
# 127.0.0.1 unless it runs in a container (then 0.0.0.0, so the published port reaches it).
API_HOST=127.0.0.1
API_PORT=3001
# Hot-reload in local dev (never set in prod/canary).
API_RELOAD=true

MONGO_URI=mongodb://localhost:27017
MONGO_DB=boilerplate

REDIS_URL=redis://localhost:6379/0

# Anything, but make it long and random per env. Empty -> every authenticated route 401s.
JWT_SECRET=
JWT_EXPIRY_SECONDS=1296000

# Super-user shared secret (privileged endpoints + private config reads). Empty -> those are disabled.
ADMIN_TOKEN=

# Authenticates as ANY user, for local debugging only. NEVER set this in a deployed env.
MASTER_PASSWORD=

# Leave the keys empty on AWS compute (an IAM role is picked up automatically).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Comma-separated FE origins. Empty -> "*" (fine locally; lock it down when deployed).
# CORS_ALLOWED_ORIGINS=http://localhost:3000
