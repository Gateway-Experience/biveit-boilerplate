# The frontend's settings, baked in at build time (Vite reads VITE_* from .env files). Copy to .env and fill in.
# None of these are secrets: they all end up in the browser.

# Where the frontend calls the backend. /api = the same origin, with your web server (or Vite's dev server, below)
# passing /api/ on to the backend. Or a full URL, e.g. https://api.example.com/api, if it lives elsewhere.
VITE_API_BASE_URL=/api
# In development: where Vite's dev server sends /api/ requests -- the backend's address (its API_PORT).
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# In development: extra host names the dev server should accept (comma-separated), e.g. when opened through a
# tunnel. Empty = localhost only.
VITE_ALLOWED_HOSTS=

# Google sign-in's client ID (see README.md). Empty = no Google sign-in.
VITE_GOOGLE_CLIENT_ID=
# The interface language.
VITE_APP_LANGUAGE=en
# Identifies this app in shared services (sent with every analytics event).
VITE_PROJECT_NAME=my-site
# Mixpanel project token. Empty = analytics off (every tracking call does nothing).
VITE_MIXPANEL_TOKEN=
# Whether visitors get a guest account automatically, and whether it's kept when they sign up.
VITE_CREATE_GUEST_ACCOUNT=false
VITE_PROMOTE_GUEST_ACCOUNT=false
