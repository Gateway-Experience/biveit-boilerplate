VITE_TEST=1
VITE_API_BASE_URL=http://localhost:3001/api
# Configure google client ID. See README.md for steps.
VITE_GOOGLE_CLIENT_ID=
# Configure i18n. Probably have to check translation mappings as well.
VITE_APP_LANGUAGE=en
# Identifies this app in shared services — attached to every mixpanel event as a super
# property, so one mixpanel project can serve several apps and still tell them apart.
VITE_PROJECT_NAME=boilerplate
# Mixpanel project token. Leave empty to disable analytics entirely — every function in
# services/analytics.ts becomes a no-op, so nothing else needs to change.
VITE_MIXPANEL_TOKEN=
# Whether to create guest account on visit.
VITE_CREATE_GUEST_ACCOUNT=false
# Whether to promote guest account when a user is created. Only effective when VITE_CREATE_GUEST_ACCOUNT=true.
VITE_PROMOTE_GUEST_ACCOUNT=false
